+impl PartType {
+    fn get_unsigned(&self, unsigned_imm: bool) -> bool {
+        match self {
+            PartType::Boolean => true,
+            PartType::Char => true,
+            PartType::I8 => false,
+            PartType::I16 => false,
+            PartType::I32 => false,
+            PartType::I64 => false,
+            PartType::U8 => true,
+            PartType::U16 => true,
+            PartType::U32 => true,
+            PartType::U64 => true,
+            PartType::ISize => false,
+            PartType::USize => true,
+            PartType::F32 => true,
+            PartType::F64 => true,
+            PartType::Mapping(_) => true,
+            PartType::VInt => unsigned_imm,
+            PartType::None => true,
+        }
+    }
+
+    fn is_mapping(&self) -> bool {
+        matches!(self, PartType::Mapping(_))
+    }
+}
