+impl FromStr for PartType {
+    type Err = ();
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "boolean" => Ok(PartType::Boolean),
+            "char" => Ok(PartType::Char),
+            "i8" => Ok(PartType::I8),
