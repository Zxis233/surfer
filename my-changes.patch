+            "i64" => Ok(PartType::I64),
+            "u8" => Ok(PartType::U8),
+            "u16" => Ok(PartType::U16),
+            "u32" => Ok(PartType::U32),
+            "u64" => Ok(PartType::U64),
+            "isize" => Ok(PartType::ISize),
+            "usize" => Ok(PartType::USize),
+            "f32" => Ok(PartType::F32),
+            "f64" => Ok(PartType::F64),
